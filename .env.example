# LLM Provider Configuration
# Choose between: gemini, openai, or mock (for offline dry-run testing)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro

# Budget & Telemetry Persistence
MAX_BUDGET_USD=5.0
CHECKPOINT_DB_PATH=.swe_cache/checkpoints.db
TRACE_LOG_DIR=.swe_cache/traces

# System Execution Settings
MAX_REPAIR_ITERATIONS=3
SANDBOX_MODE=local    # options: local, docker
SANDBOX_DOCKER_IMAGE=swe-sandbox:latest
WORKSPACE_BASE_DIR=./workspaces
AUTO_APPROVE_DEPLOYMENT=false

# Git & Delivery Configuration
GIT_AUTHOR_NAME=MAS Engineer Agent
GIT_AUTHOR_EMAIL=mas-agent@autonomous.local
GITHUB_DEFAULT_BRANCH=main
DOCKER_REGISTRY=ghcr.io/my-org
